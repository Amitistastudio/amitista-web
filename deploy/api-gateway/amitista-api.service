[Unit]
Description=Amitista token-gated API gateway
Documentation=file:/opt/amitista/api-gateway/api_gateway.py
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 /opt/amitista/api-gateway/api_gateway.py

EnvironmentFile=-/etc/amitista/api-gateway.env

Restart=always
RestartSec=2

User=amitista-api
Group=amitista-api

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/amitista/api
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
