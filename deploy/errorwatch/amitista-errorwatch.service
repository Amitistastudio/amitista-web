[Unit]
Description=Amitista error watch — count errors, compare them across a deploy
Documentation=file:/root/website/deploy/errorwatch/errorwatch.py
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/website/deploy/errorwatch/errorwatch.py
StateDirectory=amitista/errorwatch
StateDirectoryMode=0700
TimeoutStartSec=120
Nice=10

NoNewPrivileges=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
