[Unit]
Description=Amitista Shield rules feed
Documentation=file:/opt/amitista/shield-feed/shield_feed.py
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 /opt/amitista/shield-feed/shield_feed.py
ExecReload=/bin/kill -HUP $MAINPID

EnvironmentFile=-/etc/amitista/shield-feed.env

Restart=always
RestartSec=2

User=amitista-shield-feed
Group=amitista-shield-feed

InaccessiblePaths=/etc/amitista/shield-feed

NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/var/lib/amitista/shield-feed
ReadWritePaths=/var/lib/amitista/shield-feed/state
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
