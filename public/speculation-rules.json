{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          {
            "not": {
              "href_matches": [
                "/admin*",
                "/api/*",
                "/apply*",
                "/contact*",
                "/block*",
                "/csp-report*",
                "/status*"
              ]
            }
          },
          { "not": { "selector_matches": "[rel~=nofollow]" } },
          { "not": { "selector_matches": "[target]" } },
          { "not": { "selector_matches": ".no-speculate" } }
        ]
      },
      "eagerness": "moderate"
    }
  ],
  "prefetch": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          {
            "not": {
              "href_matches": [
                "/admin*",
                "/api/*",
                "/apply*",
                "/contact*",
                "/block*",
                "/csp-report*"
              ]
            }
          },
          { "not": { "selector_matches": "[rel~=nofollow]" } },
          { "not": { "selector_matches": "[target]" } },
          { "not": { "selector_matches": ".no-speculate" } }
        ]
      },
      "eagerness": "conservative"
    }
  ]
}
