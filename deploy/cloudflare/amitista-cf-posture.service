[Unit]
Description=Amitista Cloudflare posture check
Documentation=file:/root/website/deploy/cloudflare/cf-posture-check.sh
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/amitista/cf.env
ExecStart=/root/website/deploy/cloudflare/cf-posture-check.sh
TimeoutStartSec=180
