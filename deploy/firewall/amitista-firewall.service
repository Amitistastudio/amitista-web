[Unit]
Description=Install the staged Amitista firewall config and reload nginx
After=nginx.service
Requisite=nginx.service

[Service]
Type=oneshot
ExecStart=/opt/amitista/firewall/apply-firewall.sh
TimeoutStartSec=60
Nice=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
