/var/log/nginx/amitista.access.log
/var/log/nginx/amitista.error.log
/var/log/nginx/amitista.csp.log
/var/log/nginx/mta-sts.access.log
/var/log/nginx/mta-sts.error.log {
    daily
    rotate 13
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -f /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}

/var/log/amitista/firewall.log {
    daily
    rotate 13
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data amitista-admin
    sharedscripts
    postrotate
        if [ -f /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}
