[Unit]
Description=Carry out the panel's GitHub access changes now
Documentation=file:/root/website/deploy/autodeploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/root/website/deploy/autodeploy/github-queue-now.sh
TimeoutStartSec=300
