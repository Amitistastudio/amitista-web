[Unit]
Description=Amitista admin API
Documentation=file:/opt/amitista/admin-api/admin_api.py
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/python3 /opt/amitista/admin-api/admin_api.py

EnvironmentFile=-/etc/amitista/admin.env
EnvironmentFile=-/etc/amitista/alerts.env
EnvironmentFile=-/etc/amitista/shield.env
EnvironmentFile=-/etc/amitista/bot.env

Restart=always
RestartSec=2

User=amitista-admin
Group=amitista-admin

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/amitista/admin/session
ReadWritePaths=/var/lib/amitista/tokens
ReadWritePaths=/var/www/amitista.com/shared
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
