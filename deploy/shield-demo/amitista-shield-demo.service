[Unit]
Description=Amitista Shield evaluator
After=network.target

[Service]
Type=simple
User=amitista-shield
Group=amitista-shield
WorkingDirectory=/opt/amitista/shield-demo
ExecStart=/opt/node/bin/node /opt/amitista/shield-demo/evaluate.js
EnvironmentFile=-/etc/amitista/shield.env
Environment=NODE_ENV=production
Environment=SHIELD_DEMO_HOST=127.0.0.1
Environment=SHIELD_DEMO_PORT=8093
Environment=SHIELD_DEMO_STATE=/var/lib/amitista/shield
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/amitista/shield
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @obsolete
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

IPAddressDeny=any
IPAddressAllow=localhost

MemoryMax=192M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
